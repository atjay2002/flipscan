<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Camera only. FlipScan deliberately has NO INTERNET permission. ML Kit's manifest merges
         its own permissions; INTERNET and ACCESS_NETWORK_STATE are explicitly removed because the
         bundled OCR model never needs the network, and FlipScan keeps that invariant at build time. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Normal permission, no runtime dialog: lets the system show the biometric prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Only needed to save into Downloads on Android 7-9; newer versions use MediaStore without it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <application
        android:name=".FlipScanApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="FlipScan"
        android:theme="@style/Theme.FlipScan">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="app.flipscan.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Portrait is a product decision: the capture and layout flows are designed for it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
